# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Your Anthropic API key (used in Step 5 and later)
ANTHROPIC_API_KEY=your-api-key-here

# LibreOffice executable path (used in Step 4)
# Windows default: C:\Program Files\LibreOffice\program\soffice.exe
# macOS default: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Linux default: /usr/bin/soffice
LIBREOFFICE_PATH=soffice

# Maximum upload file size in megabytes
MAX_UPLOAD_MB=50

# Seconds to wait before cancelling a LibreOffice conversion
CONVERSION_TIMEOUT_SECONDS=120
